<?xml version="1.0" encoding="utf-8"?>
<!--
  M512: the encrypted storage (tvh_secure_prefs) MUST NOT be backed up.

  The key it is encrypted with lives in the Android Keystore and cannot be backed up —
  so after a restore on another device (or after a reinstall) there would be an
  encrypted file without its key and the app would crash at startup with AEADBadTagException.
  The same reasoning applies to the EPG cache as well: it is only a temporary copy from the server.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tvh_secure_prefs.xml" />
        <exclude domain="file" path="epg_cache" />
        <!-- M736: the diagnostic logs (crash.log, player.log) are device-local and never backed up -->
        <exclude domain="file" path="diag" />
        <exclude domain="sharedpref" path="boot_receiver.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tvh_secure_prefs.xml" />
        <exclude domain="file" path="diag" />
        <exclude domain="sharedpref" path="boot_receiver.xml" />
    </device-transfer>
</data-extraction-rules>
